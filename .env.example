# ---------------------------------------------------------------------------
# FutureProof — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# The app runs with NONE of these filled in (offline demo mode). Add them one
# at a time, in the order below. See guidelines.md for the walkthrough.
# ---------------------------------------------------------------------------

# --- Step 0: behaviour -----------------------------------------------------
# 'true' = deterministic offline mode: no external AI calls at all.
# The demo always works with this enabled. Set to 'false' once a key is added.
FUTUREPROOF_OFFLINE=true

# --- Step 1: LLM (extraction + explanations, never scoring) ----------------
# Add a Groq key, and optionally a Gemini key as a backup.
#   Groq   -> https://console.groq.com/keys
#   Gemini -> https://aistudio.google.com/apikey
# 'auto' tries every provider that has a key, in the order groq, gemini, anthropic,
# openai. If one fails (rate limit, outage) the next one is used as a backup.
LLM_PROVIDER=auto

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional alternatives, supported behind the same interface
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Step 2: embeddings (semantic skill matching) --------------------------
# 'auto' = gemini if GOOGLE_API_KEY exists, else openai, else the offline
# local embedder (deterministic hashed vectors — works with no key at all).
EMBEDDING_PROVIDER=auto
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_MODEL=text-embedding-3-small
# 1536 = OpenAI text-embedding-3-small (schema default)
#  768 = Gemini text-embedding-004 -> apply supabase/migrations/0002_*.sql
EMBEDDING_DIMENSIONS=1536

# --- Step 3: Supabase (optional, for accounts + persistence + pgvector) ----
# Project region: Singapore (ap-southeast-1) — see docs/DATA_SOVEREIGNTY.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the seed loader and the audit-log writer.
# Never expose this in a NEXT_PUBLIC_ variable or in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional --------------------------------------------------------------
# Public origin used by app/sitemap.ts. Set it before deploying.
NEXT_PUBLIC_SITE_URL=
